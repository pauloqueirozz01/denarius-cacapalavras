APP_NAME="Denarius Finance Game"
# Referência exclusivamente para desenvolvimento local; nunca copie estes valores para produção.
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=denarius
DB_USERNAME=denarius
DB_PASSWORD=denarius
DB_ROOT_PASSWORD=root
FORWARD_DB_PORT=3307
PHPMYADMIN_PORT=8081

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Em produção, defina true somente depois de confirmar HTTPS no domínio.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

# Set all three values only when you want AdminUserSeeder to create a local admin.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Login: falhas por e-mail + IP, e teto de tentativas por IP (rede do evento inteira).
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_DECAY_SECONDS=60
AUTH_LOGIN_IP_MAX_ATTEMPTS=300
# Cadastro: envios por e-mail + IP, e teto por IP que libera uma sala na mesma rede.
AUTH_REGISTER_EMAIL_MAX_ATTEMPTS=5
AUTH_REGISTER_IP_MAX_ATTEMPTS=120
AUTH_REGISTER_DECAY_MINUTES=1

# Ranking: intervalo de atualização no navegador e cache compartilhado no servidor.
LEADERBOARD_POLL_INTERVAL_SECONDS=10
LEADERBOARD_CACHE_SECONDS=10

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# O app não despacha jobs atualmente; sync evita exigir worker no host compartilhado.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@denarius.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
